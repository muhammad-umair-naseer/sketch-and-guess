# Copy to .env and adjust. The server reads .env from the directory you start it in.

# HTTP + WebSocket port.
PORT=3000

# SQLite database file (created along with its folder if missing).
# In production, point this at a persistent volume.
DB_PATH=./data/sketch.db

# Set only when running behind a reverse proxy. Passed to Express's
# "trust proxy" setting, e.g. 1 (one proxy hop), loopback, or a subnet.
# TRUST_PROXY=1
